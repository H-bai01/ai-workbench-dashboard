{
  "name": "ai-workbench-dashboard",
  "private": true,
  "version": "2.9.0",
  "description": "AI Workbench Dashboard - a local-first dashboard for OpenClaw, Codex, and Claude Code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/H-bai01/ai-workbench-dashboard.git"
  },
  "homepage": "https://github.com/H-bai01/ai-workbench-dashboard#readme",
  "bugs": {
    "url": "https://github.com/H-bai01/ai-workbench-dashboard/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/safe-vite-runner.mjs dev",
    "start:all": "node scripts/start-versioned.js --profile=v2",
    "start:v2": "node scripts/start-versioned.js --profile=v2",
    "start:v2:https": "node scripts/start-https-frontend.js",
    "build": "node scripts/safe-vite-runner.mjs build",
    "preview": "node scripts/safe-vite-runner.mjs preview",
    "test:unit": "node --test --test-concurrency=1 scripts/status-detection.test.mjs scripts/local-ai-status.test.mjs scripts/output-redaction.test.mjs scripts/safe-record.test.mjs scripts/security-boundary.test.mjs scripts/security-http-integration.test.mjs scripts/browser-secret-exposure.test.mjs scripts/security-browser-media.test.mjs scripts/security-browser-dynamic-keys.test.mjs scripts/ci-foundation.test.mjs scripts/generic-defaults.test.mjs scripts/public-release-hygiene.test.mjs scripts/log-privacy.test.mjs scripts/package-lock-integrity.test.mjs scripts/stage2-project-details.test.mjs scripts/stage3-session-observation.test.mjs scripts/run-public-ci.test.mjs scripts/test-browser-executable.test.mjs scripts/version-consistency.test.mjs",
    "test:ci": "node scripts/run-public-ci.mjs",
    "test:ci:pure": "node scripts/run-public-ci.mjs --pure",
    "test:stage4c:ci": "node --test --test-concurrency=1 scripts/test-browser-executable.test.mjs scripts/run-public-ci.test.mjs scripts/ci-foundation.test.mjs",
    "test:version": "node --test scripts/version-consistency.test.mjs",
    "test:stage2": "node --test --test-concurrency=1 scripts/stage2-project-details.test.mjs scripts/stage2-project-details-browser.test.mjs",
    "test:stage3a": "node scripts/run-stage3a-isolated.mjs",
    "test:stage3a:real": "node --test --test-concurrency=1 scripts/stage3-session-observation-real.test.mjs",
    "test:stage4b:generic": "node --test --test-concurrency=1 scripts/generic-defaults.test.mjs scripts/security-browser-dynamic-keys.test.mjs",
    "test:stage4b:hygiene": "node --test --test-concurrency=1 scripts/public-release-hygiene.test.mjs scripts/security-browser-dynamic-keys.test.mjs",
    "test:stage4b:logs": "node --test --test-concurrency=1 scripts/log-privacy.test.mjs scripts/security-browser-dynamic-keys.test.mjs",
    "test:security": "node --test --test-concurrency=1 scripts/output-redaction.test.mjs scripts/safe-record.test.mjs scripts/security-boundary.test.mjs scripts/security-http-integration.test.mjs scripts/browser-secret-exposure.test.mjs scripts/security-browser-media.test.mjs scripts/security-browser-dynamic-keys.test.mjs scripts/package-lock-integrity.test.mjs",
    "test:security:real": "node --test --test-concurrency=1 scripts/security-real-gateway.test.mjs",
    "test:start:isolated": "node --test --test-concurrency=1 scripts/start-isolated.test.mjs",
    "test:macos:lifecycle": "node --test --test-concurrency=1 scripts/macos-lifecycle.test.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "audit:security": "npm audit --registry=https://registry.npmjs.org",
    "lint": "eslint . --fix",
    "lint:check": "eslint ."
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.18.1",
    "dayjs": "^1.11.20",
    "dompurify": "^3.4.11",
    "element-plus": "^2.13.7",
    "highlight.js": "^11.11.1",
    "iconv-lite": "^0.7.2",
    "marked": "^18.0.3",
    "marked-highlight": "^2.2.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/marked": "^5.0.2",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^26.1.0",
    "playwright": "^1.60.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.63.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.1.4",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.7"
  }
}
