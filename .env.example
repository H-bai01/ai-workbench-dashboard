# ─────────────────── 本机服务端安全配置 ────────────────────
# Gateway 地址和凭据只由本机服务端读取，禁止使用 VITE_ 前缀。
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# 推荐把 token 单独写入该文件并设为 0600；也可用服务端环境变量 OPENCLAW_GATEWAY_TOKEN。
# 未设置时，服务端会兼容读取 ~/.openclaw/openclaw.json，不会把值发送到浏览器。
OPENCLAW_GATEWAY_TOKEN_FILE=~/.openclaw/dashboard-gateway-token

# 额外可信前端来源（逗号分隔）。本机默认只允许 localhost、127.0.0.1 和 ::1。
# 当前本机模式通常留空；如配置可信 HTTPS 入口，也统一填写在这一项。
OPENCLAW_DASHBOARD_TRUSTED_ORIGINS=

# 工作台上传等本地数据的保存目录。默认使用项目下 data；开源部署可改到独立数据盘。
OPENCLAW_DASHBOARD_DATA_ROOT=

# 明确允许返回浏览器的公开设置。这里不能填写任何 token、密钥或密码。
OPENCLAW_PUBLIC_ELECTRICITY_PER_HOUR=2
OPENCLAW_PUBLIC_SHARE_REPO_URL=
# ─────────────────── 开源部署可选项 ────────────────────
# npm 安装 OpenClaw 时默认使用 npm 官方源；国内网络较慢时可选填镜像源。
# 示例：OPENCLAW_NPM_REGISTRY=https://repo.huaweicloud.com/repository/npm/
OPENCLAW_NPM_REGISTRY=

# 拉取 GitHub Releases 时默认只使用官方 API。
# 如确有需要，可明确填写你信任的代理地址；留空不会使用第三方代理。
# 示例：OPENCLAW_GITHUB_PROXY=https://gh-proxy.com
OPENCLAW_GITHUB_PROXY=

# ─────────────────── 语音对话（Voice Agent）───────────────────
# HTTPS 语音包装器当前暂时停用；请使用 npm run start:v2。
# 远程访问、ngrok 和公网入口默认关闭。
#
# 浏览器优先使用内置 SpeechRecognition；如果浏览器不支持，会 fallback 到下面的本地/云端 STT。
#
# 方案 A：本地命令转写。必须使用 JSON 参数数组，不经过 Shell；stdout 直接输出识别文本。
# {input} 会作为单个参数替换为临时音频文件路径。
# OPENCLAW_VOICE_STT_COMMAND_JSON=["/usr/local/bin/your-stt","--input","{input}"]
OPENCLAW_VOICE_STT_COMMAND_JSON=

# 方案 B：OpenAI 兼容音频转写接口。
# 默认 endpoint 是 https://api.openai.com/v1/audio/transcriptions，默认 model 是 whisper-1。
# 如果你用其他兼容服务，改 endpoint/model/key 即可。
OPENCLAW_VOICE_STT_API_KEY=
OPENCLAW_VOICE_STT_ENDPOINT=
OPENCLAW_VOICE_STT_MODEL=whisper-1
OPENCLAW_VOICE_LANGUAGE=Chinese
OPENCLAW_VOICE_STT_TIMEOUT_MS=120000

# 语音克隆 / TTS 合成：
# 默认 auto：优先 DashScope CosyVoice，其次本地 GPT-SoVITS，再其次自定义本地 TTS 命令。
OPENCLAW_VOICE_TTS_PROVIDER=auto

# 方案 A：DashScope CosyVoice。配置后可直接用上传/录音样本创建 voice_id，并用克隆音色朗读。
OPENCLAW_VOICE_DASHSCOPE_API_KEY=
OPENCLAW_COSYVOICE_TARGET_MODEL=cosyvoice-v3-flash
OPENCLAW_COSYVOICE_TTS_MODEL=cosyvoice-v3-flash

# 方案 B：本地 GPT-SoVITS API。示例：http://127.0.0.1:9880
OPENCLAW_GPTSOVITS_URL=
OPENCLAW_GPTSOVITS_PROMPT_TEXT=你好，这是我的声音样本。

# 方案 C：自定义本地 TTS 命令。必须使用 JSON 参数数组，不经过 Shell。
# 必须生成音频文件；使用 {output} 占位输出 wav/mp3。
# 可用占位：{text} {voiceId} {voiceName} {sample} {output}
# OPENCLAW_VOICE_TTS_COMMAND_JSON=["/path/to/tts","--text","{text}","--ref","{sample}","--out","{output}"]
OPENCLAW_VOICE_TTS_COMMAND_JSON=
OPENCLAW_VOICE_TTS_TIMEOUT_MS=120000

# Agent 显示名和头像统一读取 openclaw.json 的 agents.list，不再复制到浏览器环境变量。
